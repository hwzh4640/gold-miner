{
  "name": "gold-miner",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && tsc -p worker/tsconfig.json && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p worker/tsconfig.json",
    "relay:dev": "wrangler dev --local --port 8787 --config worker/wrangler.toml",
    "relay:deploy": "wrangler deploy --config worker/wrangler.toml"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260910.1",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.0"
  },
  "dependencies": {
    "qrcode-generator": "^2.0.4"
  }
}
